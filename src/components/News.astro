---
interface Props {
  date: string;
}

const { date } = Astro.props;
---

<div class="news-item">
  <span class="news-date">{date}</span>
  <div class="news-text"><slot /></div>
</div>

<style>
  .news-item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    column-gap: 1rem;
    align-items: baseline;
    padding: 0.35rem 0;
  }

  .news-date {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .news-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
  }

  .news-text :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .news-text :global(li),
  .news-text :global(p) {
    margin: 0;
  }

  .news-text :global(li strong) {
    color: inherit;
    font-weight: inherit;
  }

  /* Paper names match the paper card titles; venues match the venue label */
  .news-text :global(.news-paper) {
    color: var(--paper-title);
    font-weight: 700;
  }

  .news-text :global(.news-venue) {
    color: var(--status-alert);
    font-weight: 700;
  }

  .news-text :global(a) {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }

  .news-text :global(a:hover) {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .news-item {
      grid-template-columns: 1fr;
      row-gap: 0.1rem;
    }
  }
</style>
